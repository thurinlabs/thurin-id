# Copy to .env. Vite exposes VITE_* to the browser bundle — these are public-by-design keys.
# VITE_RPC_URL=https://your-node.example   # optional; default is the keyless https://ethereum.publicnode.com
VITE_NEYNAR_API_KEY=YOUR_NEYNAR_KEY                                  # Farcaster proof verification
VITE_WALLETCONNECT_PROJECT_ID=YOUR_REOWN_PROJECT_ID

# Network: mainnet (default, production), sepolia, or local (a running `anvil`).
# The v2 registry has the same address on every network. On sepolia reads go to
# https://ethereum-sepolia.publicnode.com; set VITE_SEPOLIA_RPC_URL to override.
# On local the RPC is http://127.0.0.1:8545 (VITE_LOCAL_RPC_URL to override) and
# VITE_REGISTRY_ADDRESS overrides the contract address if your deploy landed elsewhere.
VITE_CHAIN=mainnet

# A relayer (thurin relay) that pays for authorized hand-offs. Unset = no "Have Thurin publish it" button.
# VITE_RELAYER_URL=https://relay.thurin.id
